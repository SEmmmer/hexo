{
  "name": "emmmer-hexo-blog",
  "version": "1.0.0",
  "private": true,
  "description": "Emmmer 的 Hexo 博客",
  "scripts": {
    "dev": "hexo server --ip 127.0.0.1 --config _config.yml,_config.local.yml --output .cache/local",
    "server": "hexo server --ip 127.0.0.1 --config _config.yml,_config.local.yml --output .cache/local",
    "build": "hexo generate",
    "test:images": "node --test test/image-optimizer.test.cjs",
    "clean": "hexo clean",
    "new": "hexo new",
    "sync": "node tools/sync.mjs"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "hexo": {
    "version": "8.1.2"
  },
  "dependencies": {
    "cheerio": "1.2.0",
    "hexo": "8.1.2",
    "hexo-generator-archive": "2.0.0",
    "hexo-generator-category": "2.0.0",
    "hexo-generator-feed": "4.0.0",
    "hexo-generator-index": "4.0.0",
    "hexo-generator-tag": "2.0.0",
    "hexo-renderer-ejs": "2.0.0",
    "hexo-renderer-marked": "7.0.1",
    "hexo-renderer-stylus": "3.0.1",
    "hexo-server": "3.0.0",
    "hexo-theme-landscape": "1.1.0",
    "sharp": "0.35.4"
  }
}
